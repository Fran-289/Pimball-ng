<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for Pinball NG.
  Blocks all cleartext (HTTP) traffic — only HTTPS is allowed.
  This prevents man-in-the-middle attacks if network features are added in the future.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow localhost for Capacitor dev server during development -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
